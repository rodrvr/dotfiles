{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰅂 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰀵 OS",
            "keyColor": "blue"
        },
        {
            "type": "host",
            "key": "󰌢 Mac",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "󰔛 Uptime",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": "󱆃 Shell",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
