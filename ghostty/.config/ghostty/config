# ~/.config/ghostty/config - Configuración de Ghostty optimizada para macOS (Apple Silicon)

# ==============================================================================
# Tipografía (Nerd Font para compatibilidad con Starship y Eza)
# ==============================================================================
font-family = JetBrainsMono Nerd Font
font-size = 13.0
font-feature = -calt
font-feature = -liga

# ==============================================================================
# Ventana y Estilo macOS
# ==============================================================================
macos-titlebar-style = transparent
macos-option-as-alt = true
macos-window-shadow = true

window-padding-x = 12
window-padding-y = 12
window-theme = dark

# Transparencia y desenfoque nativo con GPU Metal
background-opacity = 0.85
background-blur-radius = 20

# Cursor
cursor-style = bar
cursor-style-blink = false
cursor-color = #88c0d0

# ==============================================================================
# Paleta de Colores (Tema Nord Oscuro)
# ==============================================================================
background = #2e3440
foreground = #d8dee9
selection-background = #434c5e
selection-foreground = #eceff4

# Normal colors (Nord)
palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

# Bright colors (Nord)
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

# ==============================================================================
# Shell Integration
# ==============================================================================
shell-integration = zsh
confirm-close-surface = false

# ==============================================================================
# Atajos de Teclado macOS (Mapeo de Cmd / ⌘)
# ==============================================================================
# Pestañas
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+braceleft=previous_tab
keybind = super+shift+braceright=next_tab
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5

# Divisiones (Splits)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+bracketleft=goto_split:previous
keybind = super+bracketright=goto_split:next
keybind = super+enter=toggle_split_zoom

# Portapapeles y Zoom
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
